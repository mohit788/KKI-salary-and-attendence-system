# Port for Render/Local Express Server
PORT=5000

# Turso Cloud SQLite Configuration (Optional for Cloud DB)
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Supabase Cloud Database Configuration (Optional for Supabase Sync/Backup)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Gemini AI API Key (Optional for AI Natural Language Assistant)
# GEMINI_API_KEY=your-gemini-api-key
